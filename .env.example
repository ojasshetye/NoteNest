# GEMINI_API_KEY: Required for live Gemini AI summaries, Q&A, and hints on the server.
# Configure this in Render Dashboard -> Environment -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AUTH_SECRET: Secret key used by the server to sign HMAC-SHA256 session tokens.
# Set a strong random string in Render Environment Variables.
AUTH_SECRET="replace-with-a-random-production-secret"

# PORT: Automatically injected by Render in production (falls back to 3000 locally).
PORT="3000"

# NODE_ENV: Set to "production" on Render.
NODE_ENV="development"

# APP_URL: Optional public URL where this service is hosted.
APP_URL="http://localhost:3000"

